---
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';
import TechList from './TechList.astro';

interface Props { project: Project; index: number; total: number }
const { project, index, total } = Astro.props;
const { id, data } = project;
const number = String(index + 1).padStart(2, '0');
const figure = (data.figures ?? [])[0];
---
<li class="card" id={`p-${id}`}>
  <a class="card__link" href={`/projets/${id}/`} aria-label={`${data.title} (projet ${index + 1} sur ${total})`}>
    <span class="card__img">
      {data.cover ? (
        <Image src={data.cover} alt="" widths={[400, 800]} sizes="(max-width: 900px) 85vw, 33vw" loading="lazy" />
      ) : (
        <span class="card__empty comment">capture à venir</span>
      )}
    </span>
    <span class="card__body">
      <span class="card__top"><span class="card__n">{number}</span><span class="card__path">projets/{id}/</span></span>
      <span class="card__title">{data.title}</span>
      <span class="card__sum">{data.summary}</span>
      {figure && <span class="card__fig"><b>{figure.value}</b> {figure.label}</span>}
      <span class="card__stack"><TechList stack={data.stack} /></span>
      <span class="card__more">voir le projet →</span>
    </span>
  </a>
</li>
